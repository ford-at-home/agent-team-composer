{
  "name": "agent-team-composer",
  "version": "0.1.0",
  "description": "Transform README files into GitHub project plans with AI-powered agent teams",
  "type": "module",
  "bin": {
    "agent-team-composer": "./bin/agent-team-composer.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:dev": "vite build --mode development",
    "build:npm": "node scripts/build-npm.js",
    "prepublishOnly": "npm run build:npm",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:once": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "docker:build": "docker build -t agent-team-composer .",
    "docker:run": "docker-compose up",
    "docker:dev": "docker-compose --profile development up"
  },
  "dependencies": {
