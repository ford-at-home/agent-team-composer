{
  "name": "agent-team-composer",
  "version": "1.0.7",
  "type": "module",
  "bin": {
    "agent-team-composer": "./dist/cli-bundle.js",
    "atc": "./dist/cli-bundle.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:cli-bundle",
    "build:frontend": "vite build",
    "build:cli-bundle": "node scripts/build-cli-bundle.js",
    "test:local": "npm run build && node dist/cli-bundle.js init --skip-gh-check",
    "prepublishOnly": "npm run build && npm run test:local"
  },
  "files": [
    "dist/cli-bundle.js",
    "dist/assets/**/*",
    "dist/index.html",
    "dist/*.svg",
    "dist/*.ico",
    "dist/robots.txt"
  ]
}