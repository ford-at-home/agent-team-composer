// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" for production
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  domain      String
  repository  String
  branch      String   @default("main")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  phases      Phase[]
  
  @@unique([repository, branch])
  @@index([repository])
  @@index([createdAt])
}

model Phase {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  order       Int
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  roles       PhaseRole[]
  
  @@unique([projectId, order])
  @@index([projectId])
  @@index([approved])
}

model Issue {
  id          String   @id @default(cuid())
  phaseId     String
  title       String
  description String
  role        String
  githubId    Int?     // GitHub issue number if created
  githubUrl   String?  // Full GitHub URL if created
  status      String   @default("pending") // pending, created, in_progress, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  
  @@index([phaseId])
  @@index([status])
  @@index([githubId])
}

model PhaseRole {
  id        String   @id @default(cuid())
  phaseId   String
  role      String
  createdAt DateTime @default(now())
  
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  
  @@unique([phaseId, role])
  @@index([phaseId])
}

// Audit log for tracking changes
model AuditLog {
  id         String   @id @default(cuid())
  entityType String   // project, phase, issue
  entityId   String
  action     String   // create, update, delete
  changes    Json?    // JSON object with before/after values
  userId     String?  // For future authentication
  createdAt  DateTime @default(now())
  
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Cache invalidation tracking
model CacheInvalidation {
  id        String   @id @default(cuid())
  key       String   @unique
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  
  @@index([updatedAt])
}